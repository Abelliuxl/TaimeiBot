# TaimeiBot 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# =============================================================================
# 安全配置
# =============================================================================

# 加密密钥（可选，如果不提供将使用明文存储敏感信息）
# 建议生成一个强密钥：可以使用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# =============================================================================
# 机器人核心配置
# =============================================================================

# OpenAI API 2D 服务地址
TAIMEI_OPENAI_API2D_URL=https://api.openai.com/v1/chat/completions

# OpenAI API 2D 密钥
TAIMEI_OPENAI_API2D_API_KEY=your-openai-api-key-here

# Kook 机器人 Token
TAIMEI_BOT_TOKEN=your-kook-bot-token-here

# Kook 验证 Token
TAIMEI_VERIFY_TOKEN=your-verify-token-here

# 加密 Token（用于消息加密）
TAIMEI_ENCRYPT_KEY=your-encrypt-token-here

# =============================================================================
# 机器人 ID 配置
# =============================================================================

# 机器人 ID（用于@消息识别）
TAIMEI_BOT_ID=726976194

# =============================================================================
# 频道配置
# =============================================================================

# 翻译功能频道 ID 列表（逗号分隔）
TAIMEI_TRANSLATION_CHANNELS=9446829885813673,4113108449843636

# 管理员频道 ID 列表（逗号分隔，可选）
TAIMEI_ADMIN_CHANNELS=

# =============================================================================
# 功能开关配置
# =============================================================================

# 是否启用翻译功能
TAIMEI_ENABLE_TRANSLATION=true

# 是否启用天赋查询功能
TAIMEI_ENABLE_TALENT_QUERY=true

# 是否启用 AI 聊天功能
TAIMEI_ENABLE_AI_CHAT=true

# 是否启用随机回复功能
TAIMEI_ENABLE_RANDOM_REPLY=true

# =============================================================================
# 使用说明
# =============================================================================
#
# 1. 复制此文件为 .env：
#    cp .env.example .env
#
# 2. 编辑 .env 文件，填入实际的配置值：
#    nano .env
#
# 3. 确保敏感信息（如 API 密钥、Token 等）已经正确填写
#
# 4. .env 文件包含敏感信息，请确保：
#    - 不要将 .env 文件提交到版本控制系统
#    - 在生产环境中设置适当的文件权限
#    - 定期轮换密钥和 Token
#
# 5. 环境变量优先级高于 config.json 中的配置
#
# 6. 如果提供了 ENCRYPTION_KEY，敏感信息在 config.json 中将以加密形式存储
#
# =============================================================================
